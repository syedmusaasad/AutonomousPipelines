[Unit]
Description=Pipeline storage GC: daily journal-aware report
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.system/bin/pipeline gc --dry-run
Environment=PIPELINE_GC_SWEEP=0
# Operator opt-in: after Drive OAuth, replace --dry-run with the cloud variant
# below to archive eligible artifacts, verify checksums, then sweep locally.
# ExecStart=%h/.system/bin/pipeline gc --cloud pipeline-drive --sweep
