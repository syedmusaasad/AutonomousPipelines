#!/usr/bin/env python3
"""Fake worker CLI for the characterization suite. Stands in for both worker CLIs:

  claude  `claude -p --output-format stream-json --verbose --agent pl-<role>
          --model M --effort E ...` -> Claude Code stream-json events
  codex   `codex exec --json --model M -c model_reasoning_effort="E" ... -`
          -> Codex --json events (agent comes from $PIPELINE_ROLE)
  agy     `agy --output-format stream-json --model M --effort E ... -p=<prompt>`
          -> Antigravity stream-json events (agent comes from $PIPELINE_ROLE)

Rejects the retired DevPass argv (`run`, --format, --file, --auto, --variant, --dir) as
the real CLIs would. Reads the brief from stdin, takes its working directory from the
process cwd, and behaves according to `FAKE:` lines found in the brief (or the
FAKE_DEFAULT env).

FAKE directives (in the brief task text):
  FAKE: touch <path>            create file (relative to the process cwd); $ITEM/$LANE_OUT/$REVIEW_OUT expanded
  FAKE: write <path> <<text>>   write text (single line, \\n escapes)
  FAKE: append <path> <<text>>
  FAKE: touch-on-call <n> <path>       create file only on this agent/cwd invocation
  FAKE: write-on-call <n> <path> <<text>>  write file only on this agent/cwd invocation
  FAKE: exit <code>             exit with this code after emitting events
  FAKE: sleep <seconds>
  FAKE: hang                    sleep forever without writing to stdout (stall)
  FAKE: fail-on-model <substr>  exit 1 immediately if --model contains substr
  FAKE: fail-unless-retry       exit 1 unless the brief contains 'Previous attempt failed'
  FAKE: verdict <V>             final message `VERDICT: V ...` (a sealed codex reviewer
                                cannot write; a claude worker also writes $REVIEW_OUT/review.md)
  FAKE: verdict-seq V1,V2,...   verdict by reviewer invocation (NONE = no verdict line)
  FAKE: touch-if-retry <path>   create file only on retry
  FAKE: record                  append argv+env facts to $FAKE_LOG
  FAKE: fix-surface <path>      overwrite path with register-passing text (rewrite path)
  FAKE: quota                   emit a subscription usage-limit refusal; exit 1
  FAKE: quota-on-model <substr> same as `quota`, but only when --model contains substr
"""

import json
import os
import re
import shlex
import sys
import time

MODE = ("codex" if sys.argv[1:2] == ["exec"]
        else "agy" if any(a.startswith("-p=") for a in sys.argv[1:]) else "claude")
SESSION = "ses_fake"


def out(ev):
    print(json.dumps(ev), flush=True)


def emit_start(model):
    if MODE == "agy":
        out({"event": "init", "conversation_id": SESSION, "init": {"model": model, "permission_mode": "always-proceed"}})
        return
    if MODE == "claude":
        out({"type": "system", "subtype": "init", "session_id": SESSION, "model": model})
    else:
        out({"type": "thread.started", "thread_id": SESSION})
        out({"type": "turn.started"})


def emit_text(text):
    if MODE == "agy":
        out({"event": "step_update", "step_update": {"conversation_id": SESSION, "step_index": 9, "state": "ACTIVE",
                                                     "step_type": "agent_response", "text_delta": text}})
        return
    if MODE == "claude":
        out({"type": "assistant", "session_id": SESSION,
             "message": {"role": "assistant", "content": [{"type": "text", "text": text}]}})
    else:
        out({"type": "item.completed", "item": {"id": "item_msg", "type": "agent_message", "text": text}})


def emit_command(cmd, n):
    if MODE == "agy":
        out({"event": "step_update", "step_update": {"conversation_id": SESSION, "step_index": n, "state": "DONE",
             "step_type": "tool", "tool_name": "run_command",
             "tool_info": {"name": "run_command", "parameters": {"CommandLine": cmd}}}})
        return
    if MODE == "claude":
        out({"type": "assistant", "session_id": SESSION, "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": f"toolu_ran_{n}", "name": "Bash", "input": {"command": cmd}}]}})
    else:
        out({"type": "item.started", "item": {"id": f"item_cmd_{n}", "type": "command_execution",
                                              "command": cmd, "status": "in_progress"}})


def emit_finish(text, code):
    if MODE == "agy":
        res = {"conversation_id": SESSION, "status": "SUCCESS" if code == 0 else "ERROR", "response": text,
               "usage": {"input_tokens": 1000, "output_tokens": 234, "thinking_tokens": 34,
                         "cache_read_tokens": 0, "total_tokens": 1234}}
        if code != 0:
            res["finished_reason"] = "error"
        out({"event": "result", "result": res})
        return
    if MODE == "claude":
        out({"type": "result", "subtype": "success" if code == 0 else "error_during_execution",
             "is_error": code != 0, "result": text, "session_id": SESSION, "num_turns": 1,
             "total_cost_usd": 0.0123,
             "usage": {"input_tokens": 1000, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0,
                       "output_tokens": 234, "output_tokens_details": {"thinking_tokens": 34}}})
    elif code == 0:
        out({"type": "turn.completed", "usage": {"input_tokens": 1000, "cached_input_tokens": 0,
                                                 "output_tokens": 200, "reasoning_output_tokens": 34}})
    else:
        out({"type": "turn.failed", "error": {"message": f"exit {code}"}})


def emit_quota_error():
    if MODE == "agy":
        out({"event": "result", "result": {"conversation_id": SESSION, "status": "ERROR", "finished_reason": "error",
                                           "error": "RESOURCE_EXHAUSTED: quota exceeded; resets in 4 hours"}})
        return
    if MODE == "claude":
        out({"type": "rate_limit_event", "session_id": SESSION,
             "rate_limit_info": {"status": "rejected", "rateLimitType": "five_hour", "resetsAt": 1794056400}})
        out({"type": "result", "subtype": "error_during_execution", "is_error": True, "session_id": SESSION,
             "result": "Claude usage limit reached. Your limit will reset at 5am."})
    else:
        out({"type": "error", "message": "You've hit your usage limit. Try again in 3 hours."})
        out({"type": "turn.failed", "error": {"message": "You've hit your usage limit."}})


def parse_args(argv):
    args = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            args[a[2:]] = argv[i + 1]
            i += 2
            continue
        if a == "-c" and i + 1 < len(argv):
            k, _, v = argv[i + 1].partition("=")
            args["c:" + k] = v.strip('"')
            i += 2
            continue
        i += 1
    return args


def main():
    argv = sys.argv[1:]
    args = parse_args(argv)
    if argv[:1] == ["run"] or any(a.split("=")[0] in ("--format", "--file", "--auto", "--variant", "--dir")
                                  for a in argv):
        print("error: unknown option (retired DevPass argv)", file=sys.stderr, flush=True)
        sys.exit(2)
    cwd = os.getcwd()
    model = args.get("model", "")
    if MODE == "claude":
        if "-p" not in argv or args.get("output-format") != "stream-json":
            print("error: headless runs need -p --output-format stream-json", file=sys.stderr, flush=True)
            sys.exit(2)
        agent = args.get("agent", "")
        variant = args.get("effort")
    elif MODE == "codex":
        if argv[-1] != "-" or "--json" not in argv:
            print("error: codex exec needs --json and the prompt on stdin (-)", file=sys.stderr, flush=True)
            sys.exit(2)
        agent = "pl-" + os.environ.get("PIPELINE_ROLE", "")
        variant = args.get("c:model_reasoning_effort")
    else:
        if args.get("output-format") != "stream-json":
            print("error: agy headless runs need --output-format stream-json", file=sys.stderr, flush=True)
            sys.exit(2)
        agent = "pl-" + os.environ.get("PIPELINE_ROLE", "")
        variant = args.get("effort")
    if MODE == "agy":
        brief = next(a[3:] for a in argv if a.startswith("-p="))
    else:
        brief = sys.stdin.read()
    is_retry = "Previous attempt failed" in brief
    env = os.environ

    def expand(s):
        for k in ("ITEM", "LANE_OUT", "LANE", "REVIEW_OUT"):
            s = s.replace("$" + k, env.get(k, ""))
        return s

    def path(p):
        p = expand(p)
        return p if os.path.isabs(p) else os.path.join(cwd, p)

    log = env.get("FAKE_LOG")
    invocation = 1
    if log and os.path.exists(log):
        try:
            invocation += sum(1 for line in open(log) if (row := json.loads(line)).get("agent") == agent
                              and row.get("cwd") == cwd)
        except (OSError, json.JSONDecodeError):
            pass
    if log:
        with open(log, "a") as f:
            f.write(json.dumps({"agent": agent, "model": model, "variant": variant or None, "cwd": cwd,
                                "argv": argv,
                                "ITEM": env.get("ITEM"), "LANE": env.get("LANE"), "LANE_OUT": env.get("LANE_OUT"),
                                "REVIEW_OUT": env.get("REVIEW_OUT"), "retry": is_retry, "brief_len": len(brief),
                                "brief": brief, "cli": MODE, "invocation": invocation}) + "\n")

    emit_start(model)
    directives = re.findall(r"^\s*(?:- )?FAKE:\s*(.+?)\s*$", brief, flags=re.M)
    default = env.get("FAKE_DEFAULT")
    if default and not directives:
        directives = default.split(";")
    code = 0
    text_out = "done"
    for d in directives:
        parts = d.split(None, 1)
        cmd = parts[0]
        rest = parts[1] if len(parts) > 1 else ""
        if cmd == "ran":
            emit_command(rest, len(directives))
        if cmd == "commit":
            m = re.match(r"(.+?)\s+--\s+(.+)$", rest)
            if m:
                subject, fence = m.group(1), m.group(2)
                os.system("git add -- " + fence + " && git commit -q -m " + shlex.quote(subject))
            else:
                os.system("git add -A && git commit -q -m " + shlex.quote(rest))
        elif cmd == "touch":
            p = path(rest)
            os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
            open(p, "a").close()
        elif cmd == "touch-on-call":
            n, target = rest.split(None, 1)
            if invocation == int(n):
                p = path(target)
                os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
                open(p, "a").close()
        elif cmd in ("write", "append"):
            m = re.match(r"(\S+)\s+<<(.*)>>$", rest)
            p = path(m.group(1))
            os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
            with open(p, "a" if cmd == "append" else "w") as f:
                f.write(expand(m.group(2)).replace("\\n", "\n") + "\n")
        elif cmd == "write-on-call":
            m = re.match(r"(\d+)\s+(\S+)\s+<<(.*)>>$", rest)
            if invocation == int(m.group(1)):
                p = path(m.group(2))
                os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
                with open(p, "w") as f:
                    f.write(expand(m.group(3)).replace("\\n", "\n") + "\n")
        elif cmd == "exit":
            code = int(rest)
        elif cmd == "sleep":
            time.sleep(float(rest))
        elif cmd == "hang":
            time.sleep(3600)
        elif cmd == "fail-on-model":
            if rest in model:
                emit_text(f"model {model} refused")
                emit_finish(f"model {model} refused", 1)
                sys.exit(1)
        elif cmd == "quota-on-model":
            if rest in model:
                emit_quota_error()
                sys.exit(1)
        elif cmd == "fail-unless-retry":
            if not is_retry:
                code = 1
                text_out = "first attempt fails on purpose"
        elif cmd == "touch-if-retry":
            if is_retry:
                p = path(rest)
                os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
                open(p, "a").close()
        elif cmd in ("verdict", "verdict-seq"):
            if cmd == "verdict":
                v = rest
            else:
                seq = rest.split(",")
                v = seq[min(invocation, len(seq)) - 1].strip()
            record = "no verdict line here" if v == "NONE" else \
                f"VERDICT: {v}\n\n## Findings\n- none\n\n## Rationale\nfake by {agent}"
            text_out = record
            review_out = env.get("REVIEW_OUT")
            if review_out and MODE == "claude":
                os.makedirs(review_out, exist_ok=True)
                open(os.path.join(review_out, "review.md"), "w").write(record + "\n")
        elif cmd == "fix-surface":
            if "SURFACE scoring failed" in brief:
                p = path(rest)
                good = ("The pipeline lands verified work from plans. Each phase names one role and one set of EXIT predicates. "
                        "The engine runs the predicates after the worker stops. A failing predicate blocks completion. "
                        "The journal records every dispatch with its model, wall clock, and tokens. Status reads the journal. "
                        "Liveness comes from the process table and the transcript mtime. The sentry relights dead engines up to three times. "
                        "Deliberate stops wait for the operator. Run `pipeline status` to see work in flight.\n")
                open(p, "w").write(good)
        elif cmd == "record":
            pass
        elif cmd == "quota":
            emit_quota_error()
            sys.exit(1)
    emit_text(text_out)
    emit_finish(text_out, code)
    sys.exit(code)


if __name__ == "__main__":
    main()
